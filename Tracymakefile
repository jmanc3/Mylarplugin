# Set TRACY_DIR to a Tracy checkout containing public/TracyClient.cpp.
TRACY_DIR ?= ./tracy
# Optimized captures by default. Use DEFAULT_BUILD=debug for a debug load.
DEFAULT_BUILD := $(if $(filter debug,$(MAKECMDGOALS)),debug,release)
BUILD_DIR := out/tracy/$(DEFAULT_BUILD)
EXTRA_CXX_FLAGS := -I$(TRACY_DIR)/public -DTRACY_ENABLE -DTRACY_NO_MEMORY -DTRACY_ON_DEMAND -fno-omit-frame-pointer -g1 -pthread
# Tracy owns thread-local destructors. Keep those in its client library so
# they do not pin the plugin itself in memory across a Hyprland reload.
EXTRA_LIBS := -Wl,-rpath,'$$ORIGIN'
EXTRA_LINK_INPUTS := $(BUILD_DIR)/libmylar-tracy.so

include Makefile

$(EXTRA_LINK_INPUTS): $(BUILD_DIR)/TracyClient.o
	$(CXX) -shared -Wl,-soname,libmylar-tracy.so $< -pthread -ldl -o $@

$(BUILD_DIR)/TracyClient.o: $(TRACY_DIR)/public/TracyClient.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXX_FLAGS) $(EXTRA_CXX_FLAGS) -MMD -MP -c $< -o $@

-include $(BUILD_DIR)/TracyClient.d

clean: clean-tracy-client
.PHONY: clean-tracy-client
clean-tracy-client:
	$(RM) $(EXTRA_LINK_INPUTS) $(BUILD_DIR)/TracyClient.o $(BUILD_DIR)/TracyClient.d
