#MORE_DEBUG_FLAGS := -DDEBUGTITLEBAR

#MORE_DEBUG_FLAGS := -DDEBUGCONTAINERS
#when we upgrade to a new version these need to be handled one by one
#MORE_DEBUG_FLAGS := -DFORK_WARN

PLUGIN_NAME = mylar-desktop
MAKEFLAGS += -j16
BUILD_DIR ?= out

# --- Installation paths ---
PREFIX ?= /usr
SHARE_DIR = $(PREFIX)/share/mylardesktop
RES_DIR = ./res

# --- Source discovery ---
SOURCE_FILES := $(wildcard ./src/*.cpp ./src/*/*.cpp)
OBJECT_FILES := $(patsubst ./%, $(BUILD_DIR)/%, $(SOURCE_FILES:.cpp=.o))
DEP_FILES := $(OBJECT_FILES:.o=.d)

# --- Pkg-config dependencies ---
PKG_FLAGS := $(shell pkg-config --cflags librsvg-2.0 libdrm hyprland pangocairo pangoft2 wayland-server wayland-client wayland-cursor xkbcommon cairo gtk+-3.0 xcb-ewmh xcb xcb-damage xcb-composite dbus-1 alsa libpipewire-0.3 libpulse gio-2.0 egl glesv2 wayland-egl)
PKG_LIBS  := $(shell pkg-config --libs librsvg-2.0 libdrm hyprland pangocairo pangoft2 wayland-server wayland-client wayland-cursor xkbcommon cairo gtk+-3.0 xcb-ewmh xcb xcb-damage xcb-composite dbus-1 alsa libpipewire-0.3 libpulse gio-2.0 egl glesv2 wayland-egl)

# --- Include paths ---
INCLUDE_FLAGS := -I./include

# --- Common compiler flags ---
COMMON_FLAGS := -std=c++2b -fPIC --no-gnu-unique -fno-gnu-unique -Wno-unknown-argument $(INCLUDE_FLAGS) $(PKG_FLAGS)

# --- Build type flags ---
DEBUG_FLAGS := -g -O0 $(MORE_DEBUG_FLAGS)
RELEASE_FLAGS := -O3 -DNDEBUG

# --- Output ---
OUTPUT = $(BUILD_DIR)/$(PLUGIN_NAME).so

.PHONY: all debug release clean load unload install uninstall

# --- Default target ---
DEFAULT_BUILD ?= debug
all: $(DEFAULT_BUILD)

# --- Build modes ---
debug: CXX_FLAGS := $(COMMON_FLAGS) $(DEBUG_FLAGS)
release: CXX_FLAGS := $(COMMON_FLAGS) $(RELEASE_FLAGS)

debug: $(OUTPUT) $(BUILD_DIR)/mylar-file-chooser
release: $(OUTPUT) $(BUILD_DIR)/mylar-file-chooser

$(BUILD_DIR)/mylar-file-chooser: helpers/file_chooser.cpp
	@mkdir -p $(BUILD_DIR)
	$(CXX) $< -o $@ $(shell pkg-config --cflags --libs gtk+-3.0)

# --- Link step ---
$(OUTPUT): $(OBJECT_FILES) $(EXTRA_LINK_INPUTS)
	@echo "Linking $@"
	$(CXX) -shared $^ -o $@ $(PKG_LIBS) $(EXTRA_LIBS) -lrt
	@# A thread_local with a non-trivial destructor makes glibc keep the plugin
	@# mapped after "hyprctl plugin unload", so the next load mixes old and new code.
	@if nm -D $@ | grep -q __cxa_thread_atexit; then \
		echo "error: $@ registers thread_local destructors (use trivially destructible thread_locals)"; \
		rm -f $@; exit 1; fi

# --- Compile step ---
$(BUILD_DIR)/src/settings.o: CPPFLAGS += -DMYLAR_FILE_CHOOSER_PATH='"$(SHARE_DIR)/mylar-file-chooser"'
$(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	@echo "Compiling $<"
	$(CXX) $(CPPFLAGS) $(CXX_FLAGS) $(EXTRA_CXX_FLAGS) -MMD -MP -c $< -o $@

# Header dependencies generated by -MMD, so editing a .h rebuilds the .cpp files that include it
-include $(DEP_FILES)

# --- Install resources ---
install: $(BUILD_DIR)/mylar-file-chooser
	@test -d "$(RES_DIR)" || (echo "Error: $(RES_DIR) directory not found"; exit 1)
	@echo "Installing resources to $(SHARE_DIR)"
	install -d "$(SHARE_DIR)"
	cp -a "$(RES_DIR)/." "$(SHARE_DIR)/"
	install -m755 $(BUILD_DIR)/mylar-file-chooser "$(SHARE_DIR)/mylar-file-chooser"
	@echo "Resources installed successfully."

# --- Uninstall resources ---
uninstall:
	rm -rf "$(SHARE_DIR)"

# --- Utility targets ---
clean:
	$(RM) $(OUTPUT) $(BUILD_DIR)/mylar-file-chooser $(OBJECT_FILES) $(DEP_FILES)

# Unload only after the build succeeded: a failed compile/link stops make before
# this recipe runs, so the currently loaded plugin keeps working.
load: all
	-hyprctl plugin unload ${PWD}/$(OUTPUT)
	sleep 1s; hyprctl plugin load ${PWD}/$(OUTPUT)

unload:
	hyprctl plugin unload ${PWD}/$(OUTPUT)
